      $(".notice-list li").each(function (index) {
        if ($(this).next(".notice-detail").length === 0) {
          $(this).after("<div class='notice-detail'>" + noticeDetailText[index] + "</div>");
        }
      });

      $(".notice-list li").on("click", function () {
        $(this).next(".notice-detail").stop().slideToggle(220);
      });

      // 예약 실패 시 폼 흔들림, 성공 시 팝업과 confetti 효과
      $("#reserveBtn").on("click", function () {
        setTimeout(function () {
          if ($("#reservationResult").hasClass("error")) {
            $(".form-box").addClass("shake");
            setTimeout(() => $(".form-box").removeClass("shake"), 350);
          } else if ($("#reservationResult").is(":visible")) {
            $("#reserveModal").css("display", "flex").hide().fadeIn(220);
            makeConfetti();
          }
        }, 80);
      });

      $("#modalClose, #reserveModal").on("click", function (e) {
        if (e.target.id === "reserveModal" || e.target.id === "modalClose") {
          $("#reserveModal").fadeOut(220);
        }
      });

      function makeConfetti() {
        for (let i = 0; i < 34; i++) {
          const piece = $("<span class='confetti'></span>");
          piece.css({
            left: Math.random() * 100 + "vw",
            animationDelay: Math.random() * 0.35 + "s",
            opacity: Math.random() * 0.7 + 0.3
          });
          $("body").append(piece);
          setTimeout(() => piece.remove(), 2200);
        }
      }
    });
  </script>
</body>
</html>