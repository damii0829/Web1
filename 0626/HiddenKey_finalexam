  <script>
    $(function () {
      let selectedDate = "";
      let selectedTime = "";
      let statsAnimated = false;

      // 테마별 시간표 데이터
      const timeTable = {
        "사라진 연구원": ["11:00", "13:00", "15:00", "17:00", "19:00", "21:00"],
        "새벽의 병원": ["11:30", "13:30", "15:30", "17:30", "19:30", "21:30"],
        "마법사의 서재": ["12:00", "14:00", "16:00", "18:00", "20:00"],
        "🅿 블랙아웃": ["12:30", "15:00", "17:30", "20:00"]
      };

      // 인기 테마 일부 시간 마감 처리
      const soldOutTable = {
        "사라진 연구원": ["19:00"],
        "새벽의 병원": ["17:30", "21:30"],
        "마법사의 서재": ["20:00"],
        "🅿 블랙아웃": ["20:00"]
      };

      // 화면에 보이면 자연스럽게 나타나는 효과
      $(".info-card, .theme-card, .stats-card, .theme-stats, .reservation, .guide-grid, .location-box").addClass("fade-target");

      // 메뉴 클릭 시 jQuery animate로 부드럽게 이동
      $(".menu a, .hero-buttons a").on("click", function (e) {
        const target = $(this).attr("href");

        if (target && target.startsWith("#") && $(target).length) {
          e.preventDefault();

          $("html, body").animate({
            scrollTop: $(target).offset().top - 75
          }, 600);
        }
      });

      // 테마 카드 hover 효과
      $(".theme-card").hover(
        function () {
          $(this).addClass("hovered");
          $(this).find(".tag").stop().fadeTo(180, 1);
        },
        function () {
          $(this).removeClass("hovered");
          $(this).find(".tag").stop().fadeTo(180, 0.82);
        }
      );

      // 테마 카드 클릭 시 예약 폼의 테마 자동 선택
      $(".theme-card").on("click", function () {
        const themeName = $(this).find("h3").text();

        $(".theme-card").removeClass("selected");
        $(this).addClass("selected");

        $("#themeSelect").val(themeName).trigger("change");

        $("html, body").animate({
          scrollTop: $("#reservation").offset().top - 75
        }, 100);
      });

      // 테마 변경 시 시간표 동적 변경
      $("#themeSelect").on("change", function () {
        selectedTime = "";
        renderTimeButtons($(this).val());
        $("#reservationResult").fadeOut(150);
      });

      function renderTimeButtons(theme) {
        const times = timeTable[theme];
        const soldOutTimes = soldOutTable[theme] || [];

        $(".time-buttons").empty();

        times.forEach(function (time) {
          const button = $("<button type='button'></button>").text(time);

          if (soldOutTimes.includes(time)) {
            button.addClass("soldout").prop("disabled", true).text(time + " 마감");
          }

          $(".time-buttons").append(button);
        });
      }

      // 날짜 선택 상태 유지
      $(".date-box").on("click", function () {
        $(".date-box").removeClass("selected");
        $(this).addClass("selected");

        selectedDate = $(this).text().replace(/\s+/g, " ");
        $("#reservationResult").fadeOut(150);
      });

      // 시간 선택 상태 유지
      $(".time-buttons").on("click", "button:not(:disabled)", function () {
        $(".time-buttons button").removeClass("selected");
        $(this).addClass("selected");

        selectedTime = $(this).text();
        $("#reservationResult").fadeOut(150);
      });

      // 예약하기 버튼 클릭 시 입력값 확인 후 결과 출력
      $("#reserveBtn").on("click", function () {
        const theme = $("#themeSelect").val();
        const name = $("#name").val().trim();
        const phone = $("#phone").val().trim();
        const people = $("#people").val().trim();
        const memo = $("#memo").val().trim();

        if (!selectedDate || !selectedTime || !name || !phone || !people) {
          $("#reservationResult")
            .addClass("error")
            .html("⚠ 날짜, 시간, 이름, 연락처, 인원 수를 모두 입력해야 예약이 가능합니다.")
            .hide()
            .fadeIn(250);
          return;
        }

        $("#reservationResult")
          .removeClass("error")
          .html(
            "<strong>예약 정보가 확인되었습니다.</strong><br>" +
            "테마: " + theme + "<br>" +
            "날짜: " + selectedDate + "<br>" +
            "시간: " + selectedTime + "<br>" +
            "예약자: " + name + "<br>" +
            "연락처: " + phone + "<br>" +
            "인원: " + people + "<br>" +
            "요청사항: " + (memo || "없음")
          )
          .hide()
          .fadeIn(350);
      });

      // 초기화
      $("#resetBtn").on("click", function () {
        selectedDate = "";
        selectedTime = "";

        $(".date-box, .time-buttons button, .theme-card").removeClass("selected");
        $(".form-box input, .form-box textarea").val("");
        $("#themeSelect").val("사라진 연구원");
        renderTimeButtons("사라진 연구원");

        $("#reservationResult")
          .removeClass("error")
          .html("내용이 초기화되었습니다.")
          .hide()
          .fadeIn(250)
          .delay(900)
          .fadeOut(300);
      });

      // 스크롤 시 헤더 변화, 메뉴 활성화, 카드 fade-in, 성공률 애니메이션
      $(window).on("scroll", function () {
        const scrollTop = $(this).scrollTop();

        $("header").toggleClass("scrolled", scrollTop > 30);

        $(".fade-target").each(function () {
          const targetTop = $(this).offset().top;
          const windowBottom = scrollTop + $(window).height();

          if (windowBottom > targetTop + 80) {
            $(this).addClass("show");
          }
        });

        if ($("#stats").length && scrollTop + $(window).height() > $("#stats").offset().top + 150) {
          $(".theme-stats").addClass("show");

          if (!statsAnimated) {
            animateStatsNumber();
            statsAnimated = true;
          }
        }

        $("section, .reservation").each(function () {
          const id = $(this).attr("id");

          if (id && scrollTop >= $(this).offset().top - 120) {
            $(".menu a").removeClass("active");
            $(".menu a[href='#" + id + "']").addClass("active");
          }
        });
      }).trigger("scroll");

      function animateStatsNumber() {
        $(".stats-card strong").each(function () {
          const item = $(this);
          const originalText = item.text();
          const number = parseInt(originalText, 10);
          const suffix = originalText.replace(number, "");

          $({ count: 0 }).animate({ count: number }, {
            duration: 900,
            easing: "swing",
            step: function (now) {
              item.text(Math.floor(now) + suffix);
            },
            complete: function () {
              item.text(originalText);
            }
          });
        });
      }

      // 첫 화면 기본 시간표 세팅
      renderTimeButtons($("#themeSelect").val());
    });
  </script>


  <script>
